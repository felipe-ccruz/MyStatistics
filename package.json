{
  "name": "mystatistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "pnpm --filter @mystatistics/web dev",
    "dev:server": "pnpm --filter @mystatistics/server dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @mystatistics/server db:generate",
    "db:migrate": "pnpm --filter @mystatistics/server db:migrate",
    "db:studio": "pnpm --filter @mystatistics/server db:studio",
    "build": "pnpm -r build",
    "start": "pnpm --filter @mystatistics/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
