# Copie para .env e ajuste se precisar. O .env não vai pro git.

# Postgres (usado pelo docker-compose.yml e pelo server)
# 5433 no host pra não colidir com um Postgres local em 5432. Dentro do container é sempre 5432.
POSTGRES_USER=mystatistics
POSTGRES_PASSWORD=mystatistics
POSTGRES_DB=mystatistics
POSTGRES_PORT=5433
DATABASE_URL=postgres://mystatistics:mystatistics@localhost:5433/mystatistics

# Porta da API (o proxy do Vite aponta pra cá)
PORT=3333

# Better Auth (sessão de usuário)
# BETTER_AUTH_SECRET assina os cookies de sessão: mínimo de 32 caracteres. Gere um com `openssl rand -base64 32`.
# BETTER_AUTH_URL é a origem que o navegador usa: o front (:5173), porque a API é chamada pelo proxy do Vite.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
