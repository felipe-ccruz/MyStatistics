# Copie para .env e ajuste se precisar. O .env não vai pro git.

# Postgres (usado pelo docker-compose.yml e pelo server)
POSTGRES_USER=mystatistics
POSTGRES_PASSWORD=mystatistics
POSTGRES_DB=mystatistics
POSTGRES_PORT=5432
DATABASE_URL=postgres://mystatistics:mystatistics@localhost:5432/mystatistics

# Porta da API (o proxy do Vite aponta pra cá)
PORT=3333
