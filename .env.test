# Env dos testes do server (`pnpm --filter @mystatistics/server test`).
# Aponta pro serviço db-test do docker-compose.yml. Credenciais descartáveis e só locais —
# por isso este arquivo vai pro git, ao contrário do .env.
DATABASE_URL=postgres://mystatistics:mystatistics@localhost:5434/mystatistics_test

# Better Auth: segredo fixo, só para os testes (nunca use em dev nem em produção).
BETTER_AUTH_SECRET=test-only-secret-Qm7Zp2Kx9Lw4Rt6Yv8Nb3Hc5Jd1Fg0Sa
BETTER_AUTH_URL=http://localhost:5173
